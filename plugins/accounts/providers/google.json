{
  "schema_version": "elegy-account-provider/v3",
  "id": "google",
  "display_name": "Google",
  "version": "3.0.0",
  "publisher": "elegy",
  "browser_origins": ["https://accounts.google.com", "https://mail.google.com"],
  "auth_profiles": [
    {
      "id": "desktop-oauth",
      "method": "oauth_pkce",
      "issuer": "https://accounts.google.com",
      "audience": "https://www.googleapis.com",
      "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "authorization_parameters": {
        "access_type": "offline",
        "prompt": "consent",
        "include_granted_scopes": "true"
      },
      "token_url": "https://oauth2.googleapis.com/token",
      "identity": {
        "url": "https://openidconnect.googleapis.com/v1/userinfo",
        "selectors": ["/email", "/sub"]
      },
      "client": {
        "mode": "environment",
        "client_id_env": "ELEGY_GOOGLE_CLIENT_ID"
      },
      "scopes": [
        "openid",
        "email",
        "profile",
        "https://www.googleapis.com/auth/gmail.readonly"
      ],
      "creation_url": "https://accounts.google.com/signup",
      "oauth_lifecycle": {
        "refresh_url": "https://oauth2.googleapis.com/token",
        "revocation_url": "https://oauth2.googleapis.com/revoke",
        "revocation_token_type_hint": "refresh_token"
      }
    }
  ],
  "operations": {
    "profile.read": {
      "description": "Read the verified Google account profile.",
      "risk": "read",
      "scopes": ["openid", "email", "profile"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object"
      },
      "executor": {
        "kind": "http",
        "profile": "desktop-oauth",
        "method": "GET",
        "path": "/oauth2/v3/userinfo"
      }
    },
    "gmail.messages.read": {
      "description": "List Gmail message identifiers without modifying the mailbox.",
      "risk": "read",
      "scopes": ["https://www.googleapis.com/auth/gmail.readonly"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object"
      },
      "executor": {
        "kind": "http",
        "profile": "desktop-oauth",
        "method": "GET",
        "path": "/gmail/v1/users/me/messages"
      }
    }
  }
}
